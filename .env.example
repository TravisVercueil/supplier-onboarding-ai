# Local demo only. Export values before running Django; no implicit dotenv loader.
APP_ENV=demo
EXTRACTION_MODE=baseline
# Optional real extraction (documents are sent to OpenAI; synthetic only):
# EXTRACTION_MODE=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=<supported chat-completions model ID>
# Optional local PostgreSQL from docker compose:
# POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=supplier
POSTGRES_USER=supplier
POSTGRES_PASSWORD=local-demo-change-me
# Required outside demo mode. Production hosting is not configured.
# DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
